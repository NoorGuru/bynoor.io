---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/prompts.css";
import { getCollection } from "astro:content";

const prompts = (await getCollection("prompt")).sort((a, b) => a.data.order - b.data.order);
const groups = ["Learn", "Make"].map((name) => ({
  name,
  items: prompts.filter((prompt) => prompt.data.group === name),
}));
const pageUrl = "https://bynoor.io/prompts/";
---
<BaseLayout prefix="/" active="prompts" logoHref="/">
  <Fragment slot="head">
    <title>Try this | Noor</title>
    <meta name="description" content="Five assignments you paste into a chat and then finish yourself. Learn a skill, read a codebase, rehearse an interview, design a project, or plan one week.">
    <meta name="author" content="Mohammad Noor Abu Khlaif">
    <meta name="robots" content="index, follow, max-image-preview:large">
    <link rel="canonical" href={pageUrl}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Mohammad Noor Abu Khlaif">
    <meta property="og:title" content="Try this | Noor">
    <meta property="og:description" content="Five assignments you paste into a chat and then finish yourself.">
    <meta property="og:image" content="https://bynoor.io/og-image.png">
    <meta property="og:url" content={pageUrl}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Try this | Noor">
    <meta name="twitter:description" content="Five assignments you paste into a chat and then finish yourself.">
    <meta name="twitter:image" content="https://bynoor.io/og-image.png">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: "Try this",
      description: "Assignments you paste into a chat and then finish yourself.",
      url: pageUrl,
      author: { "@id": "https://bynoor.io/#person" },
      itemListElement: prompts.map((prompt, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: prompt.data.title,
        url: `https://bynoor.io/prompts/${prompt.id}/`,
      })),
    })}></script>
  </Fragment>
  <Fragment slot="pre">
    <a href="#main-content" class="skip-nav">Skip to main content</a>
  </Fragment>
  <main id="main-content" class="prompts">
    <section class="invite-wrap" aria-labelledby="invite-title">
      <img
        class="invite-wrap__photo"
        src="/try/teacher-writing-on-blackboard564.jpg"
        alt="A hand writing with chalk on a blackboard, mid-stroke."
        width="1600"
        height="1064"
      />
      <div class="invite">
        <h1 id="invite-title">
          <span class="invite__line invite__line--a" data-animate="fade-up">Try this</span>
          <span class="invite__line invite__line--b" data-animate="fade-up" data-animate-delay="80">with me</span>
        </h1>
        <p class="invite__lede" data-animate="fade-up" data-animate-delay="160">Five assignments you paste into a chat, then finish yourself.</p>
        <form class="invite__form" action="/prompts/learn-a-skill/" method="get" data-animate="fade-up" data-animate-delay="220">
          <label class="field" for="skill">
            <span>The skill</span>
            <input id="skill" name="skill" type="text" value="read a balance sheet" maxlength="160" autocomplete="off" data-skill>
          </label>
          <button class="ink-btn" type="submit">Open this slip</button>
        </form>
        <p class="invite__live" data-animate="fade-up" data-animate-delay="280">Tonight: how to <span data-live-value>read a balance sheet</span>.</p>
      </div>
    </section>

    <section class="menu" aria-labelledby="slips-heading">
      <div class="menu__sheet">
        <h2 id="slips-heading" class="menu__title" data-animate="fade-up">The slips</h2>
        <p class="menu__note" data-animate="fade-up" data-animate-delay="80">Each one opens on its own page, so you can send a single assignment.</p>
        <div class="plates">
          <figure data-animate="fade-up" data-animate-delay="120">
            <div class="plates__tilt plates__tilt--left">
              <img src="/try/mek-ii-426.jpg" alt="An open carton of white school chalk." width="1920" height="3073" loading="lazy">
            </div>
            <figcaption>School chalk. Not from my desk.</figcaption>
          </figure>
          <figure data-animate="fade-up" data-animate-delay="180">
            <div class="plates__tilt plates__tilt--right">
              <img src="/try/handwriting-magic-pages-9-and-12.jpg" alt="Two pages of a handwritten Arabic manuscript, with notes in the margin." width="1920" height="1307" loading="lazy">
            </div>
            <figcaption>A handwritten page, in Arabic. Not my notes.</figcaption>
          </figure>
        </div>
        {groups.map((group) => (
          <div class="menu__group">
            <h3 data-animate="fade-up">{group.name}</h3>
            <ul>
              {group.items.map((prompt) => (
                <li>
                  <a class="dish" href={`/prompts/${prompt.id}/`} data-animate="fade-up">
                    <span class="dish__name">{prompt.data.title}</span>
                    <span class="dish__time">{prompt.data.minutes} min</span>
                    <span class="dish__note">{prompt.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <p class="menu__close" data-animate="fade-up">Open one. Fill the blanks. Paste it into the chat you already use.</p>
        <p class="menu__close" data-animate="fade-up">Then close the chat and do the work.</p>
      </div>
    </section>

    <section class="method" aria-labelledby="method-heading">
      <div class="method__copy">
        <h2 id="method-heading" class="method__title" data-animate="fade-up">How a slip<br>works</h2>
        <p class="method__lede" data-animate="fade-up" data-animate-delay="80">The model drafts and marks. You still have to practice, decide, and ship. The slip is written so it stops and waits for you.</p>
        <figure class="method__drawing" data-animate="settle">
          <img src="/try/young-woman-writing-or-drawing.jpg" alt="A red-chalk drawing of a young person writing, eyes on the page, pen in hand." width="1594" height="2250" loading="lazy">
          <figcaption>Someone writing, drawn in red chalk around the 1600s. Not a portrait of me.</figcaption>
        </figure>
      </div>
      <div class="method__side">
      <div class="ticket" data-animate="fade-up">
        <h3>Before you paste</h3>
        <p class="ticket__row"><span>Name the thing in your own words</span><span class="ticket__dots" aria-hidden="true"></span><span>2 min</span></p>
        <p class="ticket__row"><span>Fill the blanks on the slip</span><span class="ticket__dots" aria-hidden="true"></span><span>3 min</span></p>
        <h3>In the chat</h3>
        <p class="ticket__row"><span>Answer only what it asks</span><span class="ticket__dots" aria-hidden="true"></span><span>15 min</span></p>
        <p class="ticket__row"><span>Stop when it tells you to try something</span><span class="ticket__dots" aria-hidden="true"></span><span>the rest</span></p>
        <h3>After</h3>
        <p class="ticket__end">You leave with work you did. About half an hour.</p>
      </div>
        <figure class="clip" data-animate="settle" data-animate-delay="80">
          <div class="clip__frame">
            <video autoplay muted loop playsinline preload="metadata" poster="/try/writing-loop-poster.jpg" width="854" height="480">
              <source src="/try/writing-loop.webm" type="video/webm">
            </video>
          </div>
          <img class="still" src="/try/writing-loop-poster.jpg" alt="A hand writing the word it is learning, pencil on a white page." width="854" height="480">
          <figcaption>A hand writing a word it is learning. Four seconds, then it starts again.</figcaption>
        </figure>
      </div>
    </section>

    <section class="reply" aria-labelledby="reply-heading">
      <p class="reply__aside" data-animate="fade-up">The longer interview notes are a different sheet, already written. <a href="/technical-interview-preparation-kit/">Open the preparation kit</a>.</p>
      <div class="reply__card">
        <h2 id="reply-heading" data-animate="fade-up">Ask for one</h2>
        <p data-animate="fade-up" data-animate-delay="80">If a slip you need is missing, send the sentence you would put at the top. I write these the way I write a lesson.</p>
        <a class="ink-btn" href="mailto:moh.noor94@gmail.com?subject=A%20slip%20to%20try&body=Try%20this%20to%20" data-animate="fade-up" data-animate-delay="140">Send the title</a>
      </div>
    </section>

    <section class="sources" aria-label="Picture credits">
      <p>The photographs and the clip are other people’s writing and teaching. They are not my classroom, my notes, or my portrait.</p>
      <ul>
        <li><a href="https://commons.wikimedia.org/wiki/File:Teacher-writing-on-blackboard564.jpg">“Teacher writing on a blackboard”</a> by Alegri, CC BY 3.0, via Wikimedia Commons.</li>
        <li><a href="https://commons.wikimedia.org/wiki/File:MEK_II-426.jpg">“MEK II-426”</a>, a carton of school chalk, by GodeNehler, CC BY-SA 4.0, via Wikimedia Commons.</li>
        <li><a href="https://commons.wikimedia.org/wiki/File:Handwriting_-_magic_-_pages_9_and_12.jpg">“Handwriting, pages 9 and 12”</a>, public domain, via Wikimedia Commons.</li>
        <li><a href="https://www.artic.edu/artworks/82505">“Young Woman Writing or Drawing”</a>, 1600s, public domain (CC0), via the Art Institute of Chicago.</li>
        <li><a href="https://commons.wikimedia.org/wiki/File:Mersi.webm">“Mersi”</a> by Roozitaa, CC BY-SA 4.0, via Wikimedia Commons.</li>
      </ul>
    </section>
  </main>
  <script>
    const input = document.querySelector("[data-skill]");
    const slot = document.querySelector("[data-live-value]");
    if (input instanceof HTMLInputElement && slot) {
      const paint = () => {
        slot.textContent = input.value.trim() || "do the thing you named";
      };
      input.addEventListener("input", paint);
    }
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelectorAll("video").forEach((video) => {
        video.pause();
        video.removeAttribute("autoplay");
      });
    }
  </script>
</BaseLayout>
