---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/prompts.css";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const prompts = await getCollection("prompt");
  return prompts.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
const prompts = (await getCollection("prompt")).sort((a, b) => a.data.order - b.data.order);
const entry = prompts.find((prompt) => prompt.id === slug);
if (!entry) throw new Error(`Missing prompt: ${slug}`);

const pageUrl = `https://bynoor.io/prompts/${entry.id}/`;
const body = (entry.body ?? "").trim();
const others = prompts.filter((prompt) => prompt.id !== entry.id);
---
<BaseLayout prefix="/" active="prompts" logoHref="/">
  <Fragment slot="head">
    <title>{entry.data.title} | Noor</title>
    <meta name="description" content={entry.data.description}>
    <meta name="author" content="Mohammad Noor Abu Khlaif">
    <meta name="robots" content="index, follow, max-image-preview:large">
    <link rel="canonical" href={pageUrl}>
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="Mohammad Noor Abu Khlaif">
    <meta property="og:title" content={`${entry.data.title} | Noor`}>
    <meta property="og:description" content={entry.data.description}>
    <meta property="og:image" content="https://bynoor.io/og-image.png">
    <meta property="og:url" content={pageUrl}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={`${entry.data.title} | Noor`}>
    <meta name="twitter:description" content={entry.data.description}>
    <meta name="twitter:image" content="https://bynoor.io/og-image.png">
  </Fragment>
  <Fragment slot="pre">
    <a href="#main-content" class="skip-nav">Skip to main content</a>
  </Fragment>
  <main id="main-content" class="prompts">
    <section class="try-solo">
      <div class="try-solo__inner">
        <a class="try-solo__back" href="/prompts/">All prompts</a>
        <article class="prompt" data-animate="fade-up">
          <div class="prompt__head">
            <h1 class="prompt__title">{entry.data.title}</h1>
            <p class="prompt__meta">{entry.data.minutes} min</p>
          </div>
          <p class="prompt__note">{entry.data.description}</p>
          <div class="prompt__actions">
            <button
              class="prompt__copy"
              type="button"
              data-copy-from="#prompt-body"
              data-copy-msg="Prompt copied"
            >Copy prompt</button>
          </div>
          <pre class="prompt__body" id="prompt-body">{body}</pre>
        </article>
      </div>
    </section>

    <section class="try-more" aria-labelledby="more-title">
      <div class="try-more__inner">
        <h2 id="more-title" data-animate="fade-up">More to try</h2>
        <p class="try-more__lede" data-animate="fade-up" data-animate-delay="60">Another title, same idea: copy it, or open it.</p>
        <ul class="try-group__list">
          {others.map((prompt) => (
            <li class="prompt-row" data-animate="fade-up">
              <div class="prompt-row__main">
                <h3 class="prompt-row__title">
                  <a href={`/prompts/${prompt.id}/`}>{prompt.data.title}</a>
                </h3>
                <p class="prompt-row__note">{prompt.data.description}</p>
              </div>
              <p class="prompt-row__meta">{prompt.data.minutes} min</p>
              <div class="prompt-row__actions">
                <button
                  class="prompt__copy"
                  type="button"
                  data-copy-from={`#more-${prompt.id}`}
                  data-copy-msg="Prompt copied"
                >Copy prompt</button>
                <a class="prompt__open" href={`/prompts/${prompt.id}/`}>Open</a>
              </div>
              <pre class="prompt__source" id={`more-${prompt.id}`} aria-hidden="true">{(prompt.body ?? "").trim()}</pre>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
