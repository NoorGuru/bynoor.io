---
const { logoHref = "#hero" } = Astro.props;
---
<!-- Footer -->
  <footer class="footer" data-section-accent="primary">
    <a href={logoHref} class="footer__logo" data-animate="fade-up">bynoor.io</a>

    <!-- The arc: a single powerful statement -->
    <p class="footer__arc" data-animate="fade-up" data-animate-delay="100">
      <span class="footer__arc-years">14 years</span> building software.
      <span class="footer__arc-years">13 years</span> teaching it.
    </p>

    <!-- Philosophy quote -->
    <blockquote class="footer__philosophy" data-animate="fade-up" data-animate-delay="200">
      <p>"The best platform engineering is invisible. Teams should build products, not fight frameworks."</p>
    </blockquote>

    <!-- CTA -->
    <a href="https://cal.com/mohammad-noor" target="_blank" rel="noopener" class="footer__cta" data-animate="fade-up" data-animate-delay="300">
      Let's build something together
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>

    <!-- Social links row -->
    <div class="footer__socials" data-animate="fade-up" data-animate-delay="400">
      <a href="https://www.linkedin.com/in/mohnoor94" target="_blank" rel="noopener" aria-label="LinkedIn" class="footer__social-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="https://github.com/mohnoor94" target="_blank" rel="noopener" aria-label="GitHub" class="footer__social-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
      </a>
      <a href="https://www.youtube.com/c/CodeWithNoor" target="_blank" rel="noopener" aria-label="Code with Noor on YouTube" class="footer__social-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </a>
      <a href="https://x.com/mohnoor94" target="_blank" rel="noopener" aria-label="Twitter / X" class="footer__social-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a href="mailto:moh.noor94@gmail.com" aria-label="Email" class="footer__social-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
      </a>
    </div>

    <!-- Bottom line -->
    <div class="footer__bottom">
      <p class="footer__copy">2012 – <span id="year">{new Date().getFullYear()}</span></p>
      <p class="footer__made">Designed & engineered by Noor</p>
    </div>
  </footer>